#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly ENGINEERING_USER="amniora"
readonly RUNNER_USER="amniora-runner"
readonly RUNNER_GROUP="amniora-runner"
readonly DOCKER_GROUP="docker"
readonly SERVICE="amniora-runner-phase16a2b1.service"
readonly STAGE_ROOT="/home/amniora/.cache/amniora-phase16a2b1"
readonly INSTALL_ROOT="/opt/amniora-runner-phase16a2b1"
readonly STATE_ROOT="/var/lib/amniora-runner/phase16a2b1"
readonly REPLAY_ROOT="/var/lib/amniora-runner/phase16a2b1-replay"
readonly ENGINEERING_ROOT="/var/lib/amniora-phase16b-product-e2e"
readonly MEMBERSHIP_MARKER="${ENGINEERING_ROOT}/runner-docker-membership-added"
readonly CLEANUP_MARKER="${ENGINEERING_ROOT}/cleanup-complete"
readonly INITIAL_PID="${ENGINEERING_ROOT}/initial-runner.pid"
readonly INITIAL_START_TICKS="${ENGINEERING_ROOT}/initial-runner.start-ticks"
readonly INITIAL_LAUNCHER_PID="${ENGINEERING_ROOT}/initial-runner.launcher-pid"
readonly BOOTSTRAP_STATE="${STATE_ROOT}/bootstrap-state.v1"
readonly INSPECT_SCRIPT="${INSTALL_ROOT}/engineering/inspect-runtime.cjs"
readonly UNIT_PATH="/etc/systemd/system/${SERVICE}"
readonly POLICY_PATH="/etc/sudoers.d/amniora-phase16b-product-e2e"
readonly DISPATCHER_PATH="/usr/local/sbin/amniora-phase16b-product-e2e"
readonly IMAGE="amniora-local-runner:15a-1"
readonly MANAGED_LABEL="com.amniora.local-runner.managed=true"
readonly RUNTIME_MODE_LABEL="com.amniora.local-runner.runtime-mode=local-runner"
readonly BROKER_PORT="43128"

die() {
  printf 'phase16b_dispatcher_error:%s\n' "$1" >&2
  exit 64
}

require_root() {
  [[ ${EUID} -eq 0 ]] || die "root_required"
}

runner_in_docker_group() {
  /usr/bin/id -nG "$RUNNER_USER" 2>/dev/null | /usr/bin/tr ' ' '\n' | /usr/bin/grep -Fxq "$DOCKER_GROUP"
}

engineering_user_in_docker_group() {
  /usr/bin/id -nG "$ENGINEERING_USER" 2>/dev/null | /usr/bin/tr ' ' '\n' | /usr/bin/grep -Fxq "$DOCKER_GROUP"
}

require_safe_stage_file() {
  local target="$1"
  [[ -f "$target" && ! -L "$target" ]] || die "invalid_stage_file"
  [[ $(/usr/bin/realpath -e -- "$target") == "$target" ]] || die "invalid_stage_path"
  [[ $(/usr/bin/stat -c '%U' -- "$target") == "$ENGINEERING_USER" ]] || die "invalid_stage_owner"
}

validate_archive_paths() {
  local archive="$1"
  local entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    [[ "$entry" != /* && "$entry" != ".." && "$entry" != ../* && "$entry" != */../* && "$entry" != */.. ]] ||
      die "unsafe_archive_path"
  done < <(/usr/bin/tar -tf "$archive")
}

managed_container_ids() {
  /usr/bin/docker container ls -aq \
    --filter "label=${MANAGED_LABEL}" \
    --filter "label=${RUNTIME_MODE_LABEL}"
}

managed_network_ids() {
  /usr/bin/docker network ls -q \
    --filter "label=${MANAGED_LABEL}" \
    --filter "label=${RUNTIME_MODE_LABEL}"
}

managed_counts() {
  local containers networks
  containers=$(managed_container_ids | /usr/bin/wc -l)
  networks=$(managed_network_ids | /usr/bin/wc -l)
  printf '{"containers":%d,"networks":%d}\n' "$containers" "$networks"
}

write_fixed_inspector() {
  /usr/bin/cat >"$INSPECT_SCRIPT" <<'NODE'
"use strict";
const fs = require("node:fs");
const { execFileSync } = require("node:child_process");
const statePath = "/var/lib/amniora-runner/phase16a2b1/runtime/state.json";
const state = JSON.parse(fs.readFileSync(statePath, "utf8"));
if (!/^[0-9a-f]{32}$/.test(state.sessionId || "")) throw new Error("invalid_runtime_session");
if (!Number.isSafeInteger(state.generation) || state.generation < 1) throw new Error("invalid_runtime_generation");
if (!/^http:\/\/127\.0\.0\.1:\d+$/.test(state.endpoint || "")) throw new Error("invalid_runtime_endpoint");
const docker = (...args) => execFileSync("/usr/bin/docker", args, { encoding: "utf8" }).trim();
const fixed = [
  "--filter", "label=com.amniora.local-runner.managed=true",
  "--filter", "label=com.amniora.local-runner.runtime-mode=local-runner",
  "--filter", "label=com.amniora.local-runner.session=" + state.sessionId,
];
const containerIds = docker("container", "ls", "-aq", ...fixed).split("\n").filter(Boolean);
const networkIds = docker("network", "ls", "-q", ...fixed).split("\n").filter(Boolean);
const containers = containerIds.length ? JSON.parse(docker("inspect", ...containerIds)) : [];
const networks = networkIds.length ? JSON.parse(docker("network", "inspect", ...networkIds)) : [];
for (const detail of [...containers, ...networks]) {
  const labels = detail.Config?.Labels ?? detail.Labels ?? {};
  if (labels["com.amniora.local-runner.managed"] !== "true" ||
      labels["com.amniora.local-runner.runtime-mode"] !== "local-runner" ||
      labels["com.amniora.local-runner.session"] !== state.sessionId) throw new Error("unmanaged_runtime_resource");
}
(async () => {
  let lanReachable = false;
  try {
    const response = await fetch(state.endpoint.replace("127.0.0.1", "10.0.2.15"), { signal: AbortSignal.timeout(1000) });
    lanReachable = response.ok;
  } catch {}
  process.stdout.write(JSON.stringify({ containers, networks, endpoint: state.endpoint, lanReachable }));
})().catch(error => {
  process.stderr.write(String(error?.message || error) + "\n");
  process.exitCode = 1;
});
NODE
  /usr/bin/chown root:root "$INSPECT_SCRIPT"
  /usr/bin/chmod 0555 "$INSPECT_SCRIPT"
}

